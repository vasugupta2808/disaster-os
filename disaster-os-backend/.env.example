# ==============================================================================
# Disaster OS Backend - Environment Variables
# Copy this file to .env and fill in real values. Never commit .env itself.
# ==============================================================================

# --- App ---
APP_ENV=development
# development | staging | production
DEBUG=true
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGINS=http://localhost:3000

# --- Database (relational data: kit templates, offline guide content, audit logs) ---
# Local dev default (SQLite, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./disaster_os.db
# Production example (Postgres):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/disaster_os

# --- Firebase Admin SDK ---
# Path to the service account JSON downloaded from Firebase Console >
# Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Gemini AI (text chat + vision image analysis) ---
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- Google Maps (server-side: geocoding, places search for shelters/hospitals/fire stations) ---
# Get from https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_SERVER_API_KEY=your-server-side-maps-api-key

# --- OpenWeather (live weather alerts) ---
# Get from https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your-openweather-api-key

# --- ReliefWeb (disaster reports, no key required but identify your app) ---
RELIEFWEB_APP_NAME=disaster-os-hackathon

# --- NASA FIRMS (wildfire detection, optional feature) ---
# Get from https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=your-firms-api-key

# --- Admin Access (SOS Management Panel) ---
# Comma-separated Firebase UIDs who can see/update all SOS requests.
# Find your UID: Firebase Console > Authentication > Users > copy UID column.
# Example: ADMIN_UIDS=abc123uid,def456uid
ADMIN_UIDS=your-firebase-uid-here
